# ===========================================================================
# OpenWA — Homelab config (Mac M1 Max host → NAS/NUC services)
# Fill the 6 <<< FILL >>> values below, then: npm install && npm run dev
# ===========================================================================

# ---- Server ----
NODE_ENV=production
PORT=2785
API_PORT=2785
LOG_LEVEL=info
ENABLE_SWAGGER=true
AUTO_START_SESSIONS=true          # re-auth saved sessions on boot
MAX_CONCURRENT_SESSIONS=10

# ---- Security (generated for you; keep secret) ----
# API_MASTER_KEY is a boot-time security guard (prod refuses placeholders); it is NOT the
# request key. Your admin request key was auto-generated in data/.api-key (owa_k1_...).
# Send it on every request as:  X-API-Key: owa_k1_...
API_MASTER_KEY=f6d4ccc9a105c18e6df7f445bb3154d9deee274566d73c7192c5f72241169d31
CORS_ORIGINS=*                    # tighten to your dashboard origin(s) later

# ===========================================================================
# DATABASE  →  your homelab PostgreSQL
# ===========================================================================
DATABASE_TYPE=postgres
DATABASE_HOST=192.168.11.118
DATABASE_PORT=5432
DATABASE_NAME=openwa_db
DATABASE_USERNAME=openwa_db_user
DATABASE_PASSWORD=fdJ5GJ6IYEwdar*gd94jAoFY
POSTGRES_SCHEMA=public
DATABASE_SSL=false                # true only if your Postgres enforces TLS
# First boot auto-creates the schema. After it works, set this false and run
#   npm run migration:run:prod   (proper migration-managed schema).
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# ===========================================================================
# REDIS  →  your homelab Redis  (cache + BullMQ webhook queue)
# ===========================================================================
REDIS_ENABLED=true
REDIS_BUILTIN=false
REDIS_HOST=192.168.11.118
REDIS_PORT=6379
REDIS_PASSWORD=YyD0Tp54vIhmH9gyrbtDu7vDtv8zc5gL

# ===========================================================================
# STORAGE  →  your homelab MinIO (S3)   (bucket auto-created on boot)
# ===========================================================================
STORAGE_TYPE=s3
S3_ENDPOINT=http://192.168.11.100:7612
S3_BUCKET=openwa-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=meetecho
S3_SECRET_ACCESS_KEY=oFkh2TQ8XEwyyq6rbpEMhl6hOW

# ===========================================================================
# WhatsApp engine  →  whatsapp-web.js (bundled Chromium, downloaded on install)
# ===========================================================================
ENGINE_TYPE=whatsapp-web.js
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
# macOS arm64 runs Chromium natively — sandbox flags safe to keep:
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage

# ---- Webhooks (outbound to n8n / your services; configured per-session via API) ----
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_SSRF_PROTECT=false         # false so webhooks can hit private LAN IPs (n8n on homelab)

# ---- Optional: Prometheus scrape endpoint at /api/metrics ----
METRICS_TOKEN=ef548def9f8ca31b2bab66e172016517

# ---- Plugins ----
PLUGINS_ENABLED=true
PLUGINS_DIR=./data/plugins

# ---- Built-in containers: OFF (you use your own homelab services) ----
POSTGRES_BUILTIN=false
REDIS_BUILTIN=false
MINIO_BUILTIN=false

# WhatsApp browser: browserless (11.118:3001, shared with Firecrawl) with per-connection reaping DISABLED
# via ?timeout=0 (verified unlimited — survives past browserless's default 60s TIMEOUT that otherwise reaps
# the browser and wedges the session with a "detached Frame" on getChats). Why browserless and not local:
# openwa's bundled Chromium 150 crashes at launch in this hardened image (opaque GPU-process SIGTRAP, not
# fixable via seccomp/caps/flags) — an upstream image regression — so in-container Chromium is unusable now.
# Must use the WS_ENDPOINT form (browserless /json/version returns ws://0.0.0.0:3000, breaking URL auto-resolve).
# Login persists via openwa's .wwebjs_auth volume. Caveat: a browserless restart drops the browser -> restart
# the session. Fix for true self-containment: repair the image's Chromium, then clear this and go local.
# LOCAL Chrome now (self-contained): the image ships Chrome for Testing 141 at /opt/chrome
# (PUPPETEER_EXECUTABLE_PATH) because Debian's chromium 150 crashed at launch. Both remote-browser vars
# unset -> whatsapp-web.js launches local Chrome -> LocalAuth persists in /app/data (survives restarts).
# Remote fallbacks kept for reference:
#   WWEBJS_BROWSER_WS_ENDPOINT=ws://192.168.11.118:3001?timeout=0  # browserless (no auth persistence)
#   WWEBJS_BROWSER_URL=http://192.168.20.150:9223                  # dedicated Chrome on .150 (down)

# AI-agent MCP endpoint at POST /mcp
MCP_ENABLED=true

# Self-hosted OAuth 2.1 for the MCP endpoint (cloud connector)
OAUTH_ENABLED=true
OAUTH_ISSUER=https://wa.sudiptadhara.in

MCP_READONLY=false
